# Copy to ~/.config/desktape/nightly.env for contrib/systemd/desktape-nightly.service. Plain KEY=value lines
# (systemd's EnvironmentFile: no `export`, no shell expansion except what systemd itself does).

# The desktape checkout (the folder holding desktape.py). Required.
DESKTAPE_DIR=/home/you/desktape

# A Python with PyYAML (`pip install -r requirements.txt`). Default: python3 on the PATH.
#DESKTAPE_PYTHON=/usr/bin/python3

# The plan, when not ~/.config/desktape/nightly.yaml.
#DESKTAPE_NIGHTLY=/home/you/.config/desktape/nightly.yaml

# Told about a night with a failure, in one line ($DESKTAPE_ALERT and on stdin), at most 10 s.
#DESKTAPE_ALERT_CMD=notify-send desktape "$DESKTAPE_ALERT"
